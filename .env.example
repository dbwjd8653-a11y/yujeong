# .env.example
# ── 테스트 계정 ────────────────────────────────────────────────────
TEST_USER_ID=your_email@example.com
TEST_USER_PW=your_password

# ── 마이페이지 전용 더미 계정 (탈퇴/재가입, 비밀번호 변경 테스트용) ──
# 메인 계정과 반드시 분리된 더미 계정을 사용하세요 (테스트가 계정을 삭제/변경함)
# ※ 로컬은 한 번에 한 브라우저만 돌므로 아래 단일 계정으로 충분합니다.
MYPAGE_USER_ID=your_dummy_email@example.com
MYPAGE_USER_PW=your_dummy_password
MYPAGE_USER_NAME=더미 계정 이름
MYPAGE_NEW_PASSWORD=your_temp_new_password
#
# ※ CI 전용(GitHub Actions Secrets): edge·chrome 매트릭스가 병렬 실행되므로
#   파괴적 테스트의 계정 레이스를 막기 위해 브라우저별 전용 더미 계정을 등록합니다.
#   (로컬 .env에는 불필요 — 워크플로우가 아래 시크릿을 위 변수명에 주입함)
#     MYPAGE_USER_ID_EDGE   / MYPAGE_USER_PW_EDGE   / MYPAGE_USER_NAME_EDGE
#     MYPAGE_USER_ID_CHROME / MYPAGE_USER_PW_CHROME / MYPAGE_USER_NAME_CHROME
#   MYPAGE_NEW_PASSWORD 는 공유(임시 비번, 각자 계정에 잠깐 적용 후 원복)

# ── 비관리자 계정 (조직 설정 권한 테스트용) ──
NON_ADMIN_USER_ID=your_nonadmin_email@example.com
NON_ADMIN_USER_PW=your_nonadmin_password

# ── Jira 환경 설정 ────────────────────────────────────────────────

JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your_email@gmail.com"
JIRA_API_TOKEN="your_token"
JIRA_PROJECT_KEY="KAN"

# ── DISCORD WEBHOOK 설정 ─────────────────────────────────────────
DISCORD_WEBHOOK_URL=your_webhook_url
